---
import PageIntro from "../components/PageIntro.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { whatsappUrl } from "../data/site";
---

<BaseLayout title="Contato | Adriana Reis Advocacia">
  <PageIntro
    eyebrow="Contato"
    title="Apresente o contexto da sua situação."
    lead="O WhatsApp é o canal principal para iniciar uma conversa com Adriana Reis."
  />
  <div class="page-contact container">
    <a
      class="button button--primary"
      href={whatsappUrl}
      target="_blank"
      rel="noreferrer"
    >
      Falar com Adriana no WhatsApp <span aria-hidden="true">↗</span>
    </a>
  </div>
</BaseLayout>
