---
import { landingNavigation, site, whatsappUrl } from "../data/site";

const isLandingPage = Astro.url.pathname === "/";
---

<footer class="site-footer">
  <div class="site-footer__grid container">
    <div class="site-footer__brand">
      <img
        src="/images/brand/adriana-reis-logo-ivory.png"
        alt="Adriana Reis Advocacia"
        width="940"
        height="460"
        loading="lazy"
      />
      <p>Advocacia conduzida com estratégia, ética e clareza.</p>
    </div>

    <nav aria-label="Navegação do rodapé">
      <p class="site-footer__heading">
        {isLandingPage ? "Informações" : "Navegação"}
      </p>
      <ul>
        {
          !isLandingPage &&
            landingNavigation.map((item) => (
              <li>
                <a href={`/${item.href}`}>{item.label}</a>
              </li>
            ))
        }
        <li><a href="/politica-de-privacidade/">Política de privacidade</a></li>
      </ul>
    </nav>

    <div>
      <p class="site-footer__heading">Contato</p>
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noreferrer"
        data-analytics-event="whatsapp_click"
        data-analytics-placement="footer"
        data-analytics-label="WhatsApp"
      >
        WhatsApp {site.contact.whatsapp}
      </a>
    </div>
  </div>
  <div class="site-footer__legal container">
    <div class="site-footer__professional">
      <p>{site.professional.fullName}</p>
      <p>{site.professional.oab.display}</p>
      <p>{site.professional.location}</p>
    </div>
    <p>© {new Date().getFullYear()} Adriana Reis Advocacia.</p>
    <p>Conteúdo informativo. Cada situação requer análise individual.</p>
  </div>
</footer>
