---
import { Picture } from "astro:assets";
import portraitImage from "../assets/images/adriana-portrait-cutout.png";
import { whatsappUrl } from "../data/site";
---

<section class="about-preview" id="sobre" aria-labelledby="about-preview-title">
  <div class="about-preview__grid container">
    <div class="about-preview__portrait">
      <span aria-hidden="true">AR</span>
      <Picture
        src={portraitImage}
        formats={["avif", "webp"]}
        widths={[480, 640]}
        sizes="(max-width: 767px) 88vw, 42vw"
        alt="Adriana Reis"
        loading="lazy"
        class="about-preview__image"
      />
    </div>

    <div class="about-preview__content">
      <p class="eyebrow"><span aria-hidden="true"></span> Sobre Adriana Reis</p>
      <h2 id="about-preview-title">
        Uma presença pessoal à frente do escritório.
      </h2>
      <p>
        Adriana Reis dá nome e rosto ao escritório e atua em questões de Direito
        Civil, Trabalhista e Previdenciário. Cada situação precisa ser
        considerada a partir de seu contexto e de seus documentos.
      </p>
      <a
        class="button button--primary"
        href={whatsappUrl}
        target="_blank"
        rel="noreferrer"
      >
        Falar com Adriana <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>
